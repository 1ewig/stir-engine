# ==============================================================================
# EUR/USD INSTITUTIONAL SWING TRADING ENGINE - ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and populate with your API keys:
# cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI SEMANTIC CLASSIFICATION (GROQ)
# Required for real-time qualitative policy bias & intensity extraction (Qwen 3.8 27B)
# Get a key at: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here

# ------------------------------------------------------------------------------
# 2. INSTITUTIONAL NEWS & WEB EXTRACTION (TINYFISH SDK)
# Required for live dual-vector news search and deep content extraction
# Get a key at: https://agent.tinyfish.ai/api-keys
# ------------------------------------------------------------------------------
tiny_fish_api=sk-tinyfish-your_tinyfish_api_key_here

# ------------------------------------------------------------------------------
# 3. CONVEX CLOUD DATABASE & BACKEND CRON (OPTIONAL / DEPLOYMENT)
# Auto-populated when running `bun run convex:dev` or `npx convex dev`
# ------------------------------------------------------------------------------
CONVEX_DEPLOYMENT=dev:your-convex-deployment-name
CONVEX_URL=https://your-convex-deployment-name.convex.cloud
CONVEX_SITE_URL=https://your-convex-deployment-name.convex.site
